# FinRex environment template
# Copy to .env for local development. Never commit real secrets.

SECRET_KEY=change-me
FLASK_DEBUG=true

# Report Agent / LLM
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
LLM_API_VERSION=2024-12-01-preview
LLM_DEPLOYMENT_NAME=

# Optional stock technical LLM assessor
STOCK_TECH_LLM_ENABLED=false
STOCK_TECH_LLM_MODEL=
STOCK_TECH_LLM_CACHE_TTL_SECONDS=21600

# Zep memory graph
ZEP_API_KEY=your_zep_api_key
ZEP_MAX_EPISODES_PER_BUILD=40

# Persona Graph / Graphiti
GRAPHITI_ENABLED=true
GRAPHITI_BACKEND=falkordb
GRAPHITI_URI=falkor://localhost:6379
GRAPHITI_USER=
GRAPHITI_PASSWORD=
GRAPHITI_DATABASE=finrex_persona

# Financial Modeling Prep
FMP_API_KEY=your_fmp_api_key
FMP_BASE_URL=https://financialmodelingprep.com/stable

# Cloudflare D1 / Binance Square data
CLOUDFLARE_D1_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_D1_DATABASE_ID=your_cloudflare_d1_database_id
CLOUDFLARE_D1_API_TOKEN=your_cloudflare_d1_api_token
BINANCE_D1_DEFAULT_SOURCE=news
BINANCE_D1_MAX_LIMIT=50
BINANCE_D1_CONTENT_MAX_CHARS=4000

# Optional secondary LLM
LLM_BOOST_ENABLED=false
LLM_BOOST_API_KEY=
LLM_BOOST_BASE_URL=
LLM_BOOST_MODEL_NAME=
LLM_BOOST_API_VERSION=2024-12-01-preview
LLM_BOOST_DEPLOYMENT_NAME=

# Optional Hugging Face enrichment
HF_TOKEN=
HF_ENABLE_REMOTE_INFERENCE=true
HF_INFERENCE_BASE_URL=https://router.huggingface.co/hf-inference/models
HF_FINANCIAL_SENTIMENT_MODEL=mrm8488/distilroberta-finetuned-financial-news-sentiment-analysis
HF_EMOTION_MODEL=tabularisai/multilingual-emotion-classification
HF_ALLOW_NON_COMMERCIAL_MODELS=false
HF_TIMEOUT_SECONDS=8
HF_MAX_ITEMS_PER_REQUEST=12

# OASIS / Report Agent limits
OASIS_DEFAULT_MAX_ROUNDS=10
REPORT_AGENT_MAX_TOOL_CALLS=5
REPORT_AGENT_MAX_REFLECTION_ROUNDS=2
REPORT_AGENT_TEMPERATURE=0.5

# Polymarket public APIs
POLYMARKET_GAMMA_BASE=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE=https://clob.polymarket.com
POLYMARKET_CACHE_TTL=600

# Validation engine
VALIDATION_INITIAL_CAPITAL=10000
VALIDATION_MIN_EDGE=0.03
VALIDATION_MAX_POSITION_PCT=0.05
VALIDATION_POLY_FEE_PCT=0.0
VALIDATION_POLY_HALF_SPREAD_PCT=0.01
VALIDATION_DEFAULT_MODEL=price_point_calibrated_ml
